# ---------------------------------------------------------------------------
# /family (Supabase project "portfolio", East US / Ohio)
# Copy to .env.local and fill in. .env.local is gitignored — never commit it.
# ---------------------------------------------------------------------------

# Project URL. Safe to expose (it is in every request the browser makes).
NEXT_PUBLIC_SUPABASE_URL=https://zgmltllcyqylgtazunai.supabase.co

# "publishable" key (sb_publishable_...). Replaces the legacy "anon" JWT.
# Safe to expose — access is enforced by RLS, not by hiding this value.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# "secret" key (sb_secret_...). Replaces the legacy "service_role" JWT.
# BYPASSES ALL ROW LEVEL SECURITY.
# Server-side only. Never import this into a client component, never commit it,
# never paste it into a chat or an issue.
SUPABASE_SECRET_KEY=

# ---------------------------------------------------------------------------
# Local tooling (not used by the app at runtime)
# ---------------------------------------------------------------------------

# Personal access token for the Supabase MCP server and CLI.
# Create at https://supabase.com/dashboard/account/tokens
# Export it in your shell profile rather than storing it here, so the MCP
# server can read it: export SUPABASE_ACCESS_TOKEN=sbp_...
# SUPABASE_ACCESS_TOKEN=

# ---------------------------------------------------------------------------
# /family app secrets
# ---------------------------------------------------------------------------

# Signs the punch-in actor cookie (HS256). Generate with: openssl rand -base64 32
# Changing it punches everyone out, which is by design.
FAMILY_ACTOR_SECRET=

# ---------------------------------------------------------------------------
# /family seeding (npm run family:seed) — never committed, read from .env.local
# ---------------------------------------------------------------------------

# Comma-separated Google account emails allowed into the household (the parents).
FAMILY_SEED_PARENT_EMAILS=

# Optional JSON array of starting profiles/labels; see the header of
# scripts/family-seed.mjs for the exact shape. Omit to add people from Settings.
# FAMILY_SEED_PROFILES=
