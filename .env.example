# ---------------------------------------------------------------------------
# /family (Supabase project "portfolio", East US / Ohio)
# Copy to .env.local and fill in. .env.local is gitignored — never commit it.
# ---------------------------------------------------------------------------

# Project URL. Safe to expose (it is in every request the browser makes).
NEXT_PUBLIC_SUPABASE_URL=https://zgmltllcyqylgtazunai.supabase.co

# "anon" / "publishable" key. Safe to expose — access is enforced by RLS,
# not by hiding this value.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# "service_role" / "secret" key. BYPASSES ALL ROW LEVEL SECURITY.
# Server-side only. Never import this into a client component, never commit it,
# never paste it into a chat or an issue.
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------------
# Local tooling (not used by the app at runtime)
# ---------------------------------------------------------------------------

# Personal access token for the Supabase MCP server and CLI.
# Create at https://supabase.com/dashboard/account/tokens
# Export it in your shell profile rather than storing it here, so the MCP
# server can read it: export SUPABASE_ACCESS_TOKEN=sbp_...
# SUPABASE_ACCESS_TOKEN=
