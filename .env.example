# ---------------------------------------------------------------------------
# /family (Supabase project "portfolio", East US / Ohio)
# Copy to .env.local and fill in. .env.local is gitignored — never commit it.
# ---------------------------------------------------------------------------

# Project URL. Safe to expose (it is in every request the browser makes).
NEXT_PUBLIC_SUPABASE_URL=https://zgmltllcyqylgtazunai.supabase.co

# "publishable" key (sb_publishable_...). Replaces the legacy "anon" JWT.
# Safe to expose — access is enforced by RLS, not by hiding this value.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# "secret" key (sb_secret_...). Replaces the legacy "service_role" JWT.
# BYPASSES ALL ROW LEVEL SECURITY.
# Server-side only. Never import this into a client component, never commit it,
# never paste it into a chat or an issue.
SUPABASE_SECRET_KEY=

# ---------------------------------------------------------------------------
# Local tooling (not used by the app at runtime)
# ---------------------------------------------------------------------------

# Personal access token for the Supabase MCP server and CLI.
# Create at https://supabase.com/dashboard/account/tokens
# Export it in your shell profile rather than storing it here, so the MCP
# server can read it: export SUPABASE_ACCESS_TOKEN=sbp_...
# SUPABASE_ACCESS_TOKEN=

# ---------------------------------------------------------------------------
# /family app secrets
# ---------------------------------------------------------------------------

# Signs the punch-in actor cookie (HS256). Generate with: openssl rand -base64 32
# Changing it punches everyone out, which is by design.
FAMILY_ACTOR_SECRET=

# ---------------------------------------------------------------------------
# /family seeding (npm run family:seed) — never committed, read from .env.local
# ---------------------------------------------------------------------------

# The ONE household account: the door into /family. Both adults share it; who is
# acting is decided by the punch-in PINs inside, not by this. The address is
# never typed or shown — the sign-in page asks only for the password.
FAMILY_ACCOUNT_EMAIL=

# Password for that account. Read ONLY by `npm run family:seed`, which creates
# the account; nothing at runtime ever holds it — Supabase validates it.
# To rotate: change it here and seed again.
FAMILY_ACCOUNT_PASSWORD=


# Optional JSON array of starting profiles/labels; see the header of
# scripts/family-seed.mjs for the exact shape. Omit to add people from Settings.
# FAMILY_SEED_PROFILES=

# Optional: the household's IANA timezone, written by the seed to
# household_settings.timezone (FR-284) in BOTH modes. When unset the seed uses
# this machine's zone (Intl.DateTimeFormat().resolvedOptions().timeZone).
# Migration 013's 'UTC' backfill is a loud placeholder — until the seed runs,
# every event renders hours off by design. The operator's household:
# FAMILY_SEED_TIMEZONE=America/Chicago

# --- The local Supabase stack (only for `supabase start` development) ----------
# Printed by `supabase status -o env`. The CLI mints the same values on every
# machine, so they are not secrets — but they are shaped like one, so they are
# read from here rather than committed. The scripts fall back to reading
# `supabase status` directly if these are unset.
SUPABASE_LOCAL_URL=
SUPABASE_LOCAL_PUBLISHABLE_KEY=
SUPABASE_LOCAL_SECRET_KEY=

# ---------------------------------------------------------------------------
# /family notifications (008) — reminders to a device that is not looking
# ---------------------------------------------------------------------------

# The VAPID pair that identifies this app to Apple's, Google's and Mozilla's
# push services. Generate ONCE with: npx web-push generate-vapid-keys
# Regenerating invalidates every existing subscription — every device has to
# turn its switch off and on again.
#
# The public half is safe to expose: the browser needs it to subscribe and it
# can decrypt nothing. Leave both blank and push is simply off; the on-screen
# banners still work.
NEXT_PUBLIC_FAMILY_VAPID_PUBLIC_KEY=
FAMILY_VAPID_PRIVATE_KEY=

# A contact address the push services can reach if a subscription misbehaves.
# Required by the VAPID spec. E.g. mailto:you@example.com
FAMILY_VAPID_SUBJECT=

# The shared secret the reminder scan's caller must present. The only thing
# between a public URL and the household's phones, so treat it as a password.
# Generate with: openssl rand -base64 32
# The hosted project needs the SAME value as a database setting, so pg_cron can
# present it — see specs/008-family-notifications/quickstart.md §3 step 4.
FAMILY_REMINDERS_SECRET=
