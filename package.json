{
  "name": "web-portfolio",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build --turbopack",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "fallow": "fallow",
    "fallow:dead-code": "fallow dead-code --regression-baseline .specify/local/fallow-baselines/dead-code-regression.json --fail-on-regression --tolerance 0",
    "fallow:dupes": "fallow dupes --changed-since main --explain",
    "fallow:health": "fallow health --score",
    "fallow:audit": "npm run test:coverage --silent && fallow audit --changed-since main --explain --dead-code-baseline .specify/local/fallow-baselines/dead-code-baseline.json --dupes-baseline .specify/local/fallow-baselines/dupes-baseline.json --fail-on-regression --tolerance 0",
    "fallow:baseline": "fallow dead-code --save-regression-baseline .specify/local/fallow-baselines/dead-code-regression.json && fallow dead-code --save-baseline .specify/local/fallow-baselines/dead-code-baseline.json && fallow dupes --save-baseline .specify/local/fallow-baselines/dupes-baseline.json",
    "graph": "graphify update .",
    "graph:query": "graphify query",
    "test:unit": "vitest run --project unit",
    "test:policies": "FAMILY_POLICY_TESTS=1 vitest run --project policies",
    "family:seed": "node --env-file-if-exists=.env.local scripts/family-seed.mjs",
    "dev:local": "NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:55321 NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_LOCAL_REDACTED SUPABASE_SECRET_KEY=sb_secret_LOCAL_REDACTED FAMILY_ACCOUNT_EMAIL=dev@family.local next dev --turbopack",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@supabase/ssr": "^0.12.5",
    "@supabase/supabase-js": "^2.112.4",
    "@tanstack/react-query": "^5.102.8",
    "framer-motion": "^12.23.22",
    "jose": "^6.2.10",
    "lucide-react": "^0.544.0",
    "next": "^16.1.6",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-icons": "^5.5.0",
    "server-only": "^0.0.1",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.0.3",
    "@vitest/coverage-istanbul": "^4.1.11",
    "eslint": "^9",
    "eslint-config-next": "^16.1.6",
    "fallow": "^3.20.0",
    "jsdom": "^29.1.1",
    "pg": "^8.23.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.10"
  }
}
