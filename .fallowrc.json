{
  "$schema": "https://raw.githubusercontent.com/fallow-rs/fallow/main/schema.json",
  "ignorePatterns": [
    "**/*.d.ts",
    ".next/**",
    ".specify/**",
    "docs/**",
    "graphify-out/**"
  ],
  "ignoreDependencies": [
    "eslint-config-next",
    "tailwindcss",
    "@tailwindcss/postcss",
    "react-dom",
    "@types/node"
  ],
  "dynamicallyLoaded": [
    "app/**/page.tsx",
    "app/**/layout.tsx",
    "app/**/loading.tsx",
    "app/**/error.tsx",
    "app/**/not-found.tsx",
    "app/**/route.ts",
    "app/**/route.tsx",
    "app/**/template.tsx",
    "app/**/default.tsx",
    "app/**/opengraph-image.{ts,tsx}",
    "app/**/twitter-image.{ts,tsx}",
    "app/**/icon.{ts,tsx}",
    "app/**/sitemap.ts",
    "app/**/robots.ts",
    "app/**/manifest.ts",
    "middleware.ts",
    "proxy.ts",
    "instrumentation.ts",
    "next.config.{ts,js,mjs}",
    "vitest.config.ts",
    "vitest.setup.ts"
  ],
  "boundaries": {
    "zones": [
      {
        "name": "tests",
        "patterns": [
          "**/__tests__/**/*",
          "**/*.test.{ts,tsx}"
        ]
      },
      {
        "name": "family-recurrence",
        "patterns": [
          "lib/family/recurrence/**/*"
        ]
      },
      {
        "name": "family-calendar-core",
        "patterns": [
          "lib/family/calendar/expand.ts",
          "lib/family/calendar/dates.ts"
        ]
      },
      {
        "name": "family-tasks-core",
        "patterns": [
          "lib/family/tasks/**/*"
        ]
      },
      {
        "name": "family-rewards-core",
        "patterns": [
          "lib/family/rewards/**/*"
        ]
      },
      {
        "name": "family-actions",
        "patterns": [
          "lib/family/actions/**/*"
        ]
      },
      {
        "name": "ui-pages",
        "patterns": [
          "app/**/page.tsx",
          "app/**/layout.tsx",
          "app/**/loading.tsx",
          "app/**/error.tsx",
          "app/**/not-found.tsx",
          "app/**/template.tsx",
          "app/**/default.tsx"
        ]
      },
      {
        "name": "api-routes",
        "patterns": [
          "app/api/**/*"
        ]
      },
      {
        "name": "components",
        "patterns": [
          "app/components/**/*",
          "app/**/components/**/*"
        ]
      },
      {
        "name": "lib",
        "patterns": [
          "lib/**/*"
        ]
      },
      {
        "name": "config",
        "patterns": [
          "middleware.ts",
          "proxy.ts",
          "instrumentation.ts",
          "next.config.{ts,js,mjs}",
          "vitest.config.ts",
          "vitest.setup.ts"
        ]
      }
    ],
    "rules": [
      {
        "from": "family-recurrence",
        "allow": [
          "family-recurrence",
          "lib"
        ]
      },
      {
        "from": "family-calendar-core",
        "allow": [
          "family-calendar-core",
          "family-recurrence",
          "lib"
        ]
      },
      {
        "from": "family-tasks-core",
        "allow": [
          "family-tasks-core",
          "family-recurrence",
          "family-calendar-core",
          "lib"
        ]
      },
      {
        "from": "family-rewards-core",
        "allow": [
          "family-rewards-core",
          "family-tasks-core",
          "lib"
        ]
      },
      {
        "from": "family-actions",
        "allow": [
          "family-actions",
          "family-recurrence",
          "family-calendar-core",
          "family-tasks-core",
          "lib",
          "family-rewards-core"
        ]
      },
      {
        "from": "lib",
        "allow": [
          "lib",
          "family-calendar-core",
          "family-tasks-core"
        ]
      },
      {
        "from": "components",
        "allow": [
          "components",
          "lib",
          "family-calendar-core",
          "family-tasks-core",
          "family-actions",
          "family-rewards-core"
        ]
      },
      {
        "from": "ui-pages",
        "allow": [
          "ui-pages",
          "components",
          "lib",
          "family-calendar-core",
          "family-tasks-core",
          "family-actions",
          "family-rewards-core"
        ]
      },
      {
        "from": "api-routes",
        "allow": [
          "api-routes",
          "lib"
        ]
      },
      {
        "from": "tests",
        "allow": [
          "tests",
          "ui-pages",
          "api-routes",
          "components",
          "lib",
          "config",
          "family-recurrence",
          "family-calendar-core",
          "family-tasks-core",
          "family-actions",
          "family-rewards-core"
        ]
      },
      {
        "from": "config",
        "allow": [
          "config",
          "lib"
        ]
      }
    ]
  },
  "rules": {
    "unused-files": "error",
    "unused-exports": "warn",
    "unused-types": "off",
    "unused-dependencies": "warn",
    "unresolved-import": "error",
    "private-type-leaks": "warn",
    "circular-dependency": "warn",
    "duplicate-export": "warn"
  },
  "overrides": [
    {
      "files": [
        "**/*.test.{ts,tsx}",
        "**/__tests__/**/*"
      ],
      "rules": {
        "unused-files": "off",
        "unused-exports": "off"
      }
    },
    {
      "files": [
        "app/**/page.tsx",
        "app/**/layout.tsx",
        "app/**/loading.tsx",
        "app/**/error.tsx",
        "app/**/not-found.tsx",
        "app/**/template.tsx",
        "app/**/default.tsx",
        "app/**/opengraph-image.{ts,tsx}",
        "app/**/icon.{ts,tsx}",
        "app/**/sitemap.ts",
        "app/**/robots.ts",
        "app/**/manifest.ts"
      ],
      "rules": {
        "unused-exports": "off"
      }
    },
    {
      "files": [
        "app/api/**/route.ts"
      ],
      "rules": {
        "unused-exports": "off",
        "unused-files": "off"
      }
    }
  ],
  "duplicates": {
    "mode": "mild",
    "minTokens": 50,
    "minLines": 5,
    "threshold": 10
  },
  "health": {
    "maxCyclomatic": 20,
    "maxCognitive": 15,
    "coverage": "coverage/coverage-final.json"
  }
}
